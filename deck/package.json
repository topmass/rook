{
  "name": "rook-deck",
  "version": "0.1.0",
  "description": "Rook on the Steam Deck: push-to-talk, spoken answers and Rook's presence over the game, as a thin client for Rook on the PC.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "echo \"Error: no test specified\" && exit 1",
    "typecheck": "tsc --noEmit -p ."
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "rook",
    "voice-assistant"
  ],
  "author": "bencz",
  "license": "MIT",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
